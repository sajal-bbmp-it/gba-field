# Template for .env.local, .env.test and .env.prod (those files are git-ignored).
# Copy it once per environment and fill in the values, e.g.:
#   cp .env.example .env.local
# Values are baked into the JS bundle at build time: never put secrets here.

# Shown in the environment badge; leave empty for prod (badge hidden).
ENV_LABEL=Local
# Base URL of the attendance API, without a trailing slash.
API_BASE_URL=https://gisapi.bbmp.gov.in/eng-attend-test-api
API_TIMEOUT_MS=20000
